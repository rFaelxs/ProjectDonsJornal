{
  "ConnectionStrings": {
    // Bate com o docker-compose.yml. Em produção viria de variável de ambiente.
    "Jornal": "Host=localhost;Port=5432;Database=jornal;Username=jornal;Password=jornal"
  },

  // Parâmetros da spec 00. Os limiares são propostas, a calibrar no M3 com `jornal calibrar`.
  "Jornal": {
    "Recuperacao": {
      "JanelaHoras": 24,
      "LimiarSimilaridade": 0.55,
      "TopKPorTema": 12,
      "LimiarMesmoFato": 0.82,
      "RelacionadosDias": 30,
      "RelacionadosMax": 2,
      "LimiarRelacionados": 0.60
    },
    "Coleta": {
      "LimiarDuplicata": 0.93,
      "DuplicataJanelaHoras": 72,
      "TimeoutSegundos": 20,
      "ParalelismoMaximo": 4,
      "IdadeMaximaDiasPrimeiraColeta": 7
    },
    "Edicao": {
      "Nome": "O Seu Jornal",
      "MaxMaterias": 8,
      "MaxSugestoes": 2,
      "MaxPaginas": 2,
      "QrCodes": false
    },
    "Perfil": {
      "CategoriasExigidas": 4,
      "MinimoFeedsAtivosPorCategoria": 2,
      "LimiarSugestaoAuxiliar": 0.50,
      "MaxSugestoesAuxiliares": 5
    },
    "Ai": {
      "Chat": {
        "Provider": "Ollama",
        "Model": "qwen2.5:7b-instruct",
        "Endpoint": "http://localhost:11434"
      },
      "Embedding": {
        "Model": "bge-m3",
        "Endpoint": "http://localhost:11434",
        "TamanhoLote": 32
      }
    },
    "Entrega": {
      "Pasta": "data/edicoes"
    },
    "Prompts": {
      "Manchetes": "prompts/manchetes.v1.md",
      "Verificador": "prompts/verificador.v1.md",
      "ExtrairTemas": "prompts/extrair-temas.v1.md",
      "InterpretarFeedback": "prompts/interpretar-feedback.v1.md"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
